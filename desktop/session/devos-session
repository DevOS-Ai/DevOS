#!/bin/sh
# DevOS graphical session, started by the DevOS greeter through greetd (SRS DESK-010).
# Hyprland runs under UWSM, the session manager the Hyprland project recommends:
# systemd user units for the compositor and autostart, the environment exported to
# systemd and D-Bus, and a clean, ordered logout.
. /usr/lib/devos/gpu-env

# Output goes to the journal (journalctl -t devos-session), not over the console
# while the desktop starts.
if command -v uwsm >/dev/null; then
    exec systemd-cat -t devos-session uwsm start -- hyprland.desktop
fi
exec systemd-cat -t devos-session Hyprland
