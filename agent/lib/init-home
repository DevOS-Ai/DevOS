#!/bin/sh
# Prepare a user's DevOS Agent home (HERMES_HOME) before every start. Idempotent; never
# overwrites what the user changed.
#   - identity (SOUL.md) and configuration from /usr/share/devos/agent on first start
#   - the local API service: 127.0.0.1, a per-user port, a random per-user key
#   - client.json (0600) for the desktop shell: where to reach the service and the key
set -eu
umask 077

home="${HERMES_HOME:?}"
defaults=/usr/share/devos/agent
mkdir -p "$home"

[ -e "$home/SOUL.md" ] || cp "$defaults/SOUL.md" "$home/SOUL.md"
# DEFAULTS: bump when the defaults below change for homes made by an earlier package.
DEFAULTS=2
mark="$home/.devos-defaults"
if [ ! -e "$home/config.yaml" ]; then
    cp "$defaults/config.yaml" "$home/config.yaml"
    echo "$DEFAULTS" >"$mark"
elif [ "$(cat "$mark" 2>/dev/null)" != "$DEFAULTS" ]; then
    # A home from an earlier package: add the DevOS look (skin, TUI) once, and answer the
    # engine's usage-metrics question with "off" unless the user already answered it.
    cfg() { /usr/bin/python3 -I /usr/lib/devos/agent/launch.py config set "$1" "$2" >/dev/null 2>&1 || true; }
    cfg display.skin devos
    cfg display.interface tui
    if ! grep -q 'shared_metrics' "$home/config.yaml"; then
        cfg telemetry.shared_metrics.enabled false
        cfg telemetry.shared_metrics.send false
    fi
    echo "$DEFAULTS" >"$mark"
fi
# The DevOS terminal skin follows the package (other skins in skins/ are the user's).
mkdir -p "$home/skins"
cmp -s "$defaults/skins/devos.yaml" "$home/skins/devos.yaml" || cp "$defaults/skins/devos.yaml" "$home/skins/devos.yaml"

env="$home/.env"
touch "$env"
setting() { grep -q "^$1=" "$env" || printf '%s=%s\n' "$1" "$2" >>"$env"; }
value() { sed -n "s/^$1=//p" "$env" | tail -n 1; }

# One port per user so several accounts on one machine never collide.
port=$((41000 + $(id -u) % 20000))
setting API_SERVER_ENABLED true
setting API_SERVER_HOST 127.0.0.1
setting API_SERVER_PORT "$port"
setting API_SERVER_MODEL_NAME devos-agent
if [ -z "$(value API_SERVER_KEY)" ]; then
    sed -i '/^API_SERVER_KEY=/d' "$env"
    printf 'API_SERVER_KEY=%s\n' "$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')" >>"$env"
fi

client="$home/client.json"
new=$(printf '{"url": "http://127.0.0.1:%s", "key": "%s", "model": "devos-agent"}\n' \
    "$(value API_SERVER_PORT)" "$(value API_SERVER_KEY)")
[ "$(cat "$client" 2>/dev/null)" = "$new" ] || printf '%s\n' "$new" >"$client"
